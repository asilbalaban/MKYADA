# Python
__pycache__/
*.pyc

# PyInstaller cikti
build/
dist/
*.spec

# JSON makro ciktilari (istege bagli)
*.macro.json
.DS_Store

# firmware build artifacts (generated by scripts/build-firmware-dist.mjs)
firmware-dist/
scripts/.cache/

# font proofs (generated on demand by scripts/build-font.mjs --preview/--html).
# The compiled firmware/fonts/*.fnt IS committed — it ships in the bundle — but
# these are just ways of looking at it.
fonts/src/*.png
fonts/src/*-viewer.html
# one particular keypad's setup, written by scripts/dump-device.mjs
fonts/src/device.json
